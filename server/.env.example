APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@postgres:5432/forlittle?sslmode=disable
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=Temple Admin
ADMIN_SESSION_TTL_HOURS=24
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Long random value used only to enroll a Windows Time Control Service.
# Rotate it after an initial rollout and never reuse an extension enrollment key.
DEVICE_ENROLLMENT_KEY=replace-with-a-long-random-secret
